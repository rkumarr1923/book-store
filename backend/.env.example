# Book Store Backend — Environment Variables
# Copy this file to .env (gitignored) and fill in real values for local overrides.
# For production deployment, set these as secrets/env vars on the deployment platform.
# NEVER commit a file containing real credentials to source control.

# ── Spring Profile ─────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Database (Neon PostgreSQL — pooled connection) ──────────────────────────────
# For Neon, use the pooled JDBC URL with SSL parameters:
#   jdbc:postgresql://<pooler-host>/neondb?sslmode=require&channel_binding=require
# Username and password come from your Neon project → Branch → Credentials.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ── JWT ────────────────────────────────────────────────────────────────────────
# Use a strong random secret (minimum 32 characters / 256-bit).
# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ── CORS ───────────────────────────────────────────────────────────────────────
# Set to the exact frontend origin (no trailing slash).
# Example: https://your-bookstore.vercel.app
CORS_ALLOWED_ORIGIN=

# ── Server ─────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Mail (SMTP) ────────────────────────────────────────────────────────────────
# For production: set these to your real SMTP provider credentials.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Application ────────────────────────────────────────────────────────────────
DELIVERY_OFFSET_DAYS=7
TAX_RATE=0.12
RESET_TOKEN_EXPIRY=900
