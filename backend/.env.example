# Book Store Backend — Environment Variables
# Copy this file to .env and fill in real values

SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://host:5432/bookstore
DB_USERNAME=bookstore
DB_PASSWORD=your-db-password
JWT_SECRET=your-256-bit-secret-minimum-32-chars-replace-this
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080
DELIVERY_OFFSET_DAYS=7
TAX_RATE=0.12
RESET_TOKEN_EXPIRY=900
