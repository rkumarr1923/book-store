# ── BookStore Frontend — Environment Variables ─────────────────────────────────
# Copy this file to .env.production and fill in your actual deployment values.
# Never commit .env.production with real values to source control.

# Backend API base URL (no trailing slash)
# Example: https://bookstore-backend.onrender.com/api/v1
VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1

# Application name (optional — used in Navbar)
VITE_APP_NAME=BookStore
